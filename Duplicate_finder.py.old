import json
import os
from collections import defaultdict
import tkinter as tk
from tkinter import filedialog, messagebox
import sys

class JSONDuplicateFinder:
    """Find duplicate video codes across multiple JSON files loaded one by one"""
    
    def __init__(self):
        self.all_entries = defaultdict(list)  # Stores all codes from all loaded files
        self.loaded_files = []  # Track which files have been loaded
    
    def add_json_file(self, file_path):
        """
        Add a JSON file to the master list
        Returns: Number of video entries found
        """
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            
            filename = os.path.basename(file_path)
            
            # Extract video entries
            video_entries = self.extract_video_entries(data)
            count = 0
            
            for code, info in video_entries.items():
                self.all_entries[code].append({
                    'filename': info.get('filename', 'Unknown'),
                    'size_mb': info.get('size_mb', 'Unknown'),
                    'source_file': filename,
                    'full_path': file_path
                })
                count += 1
            
            if file_path not in self.loaded_files:
                self.loaded_files.append(file_path)
            
            return count
            
        except Exception as e:
            print(f"❌ Error loading {file_path}: {e}")
            return 0
    
    def extract_video_entries(self, data):
        """
        Extract only video entries from JSON
        Looks for keys like "ABC-123" format
        """
        video_entries = {}
        
        for key, value in data.items():
            # Skip if value is not a dictionary
            if not isinstance(value, dict):
                continue
            
            # Check if key looks like a video code (e.g., ABC-123, ABCD-12345)
            has_code_format = '-' in str(key) and any(c.isdigit() for c in str(key))
            
            # Check if it has video fields
            has_filename = 'filename' in value
            has_size = 'size_mb' in value
            
            if has_code_format and (has_filename or has_size):
                video_entries[key] = value
        
        return video_entries
    
    def find_duplicates(self):
        """Find all codes that appear in more than one file"""
        return {code: entries for code, entries in self.all_entries.items() 
                if len(entries) > 1}
    
    def print_duplicates(self):
        """Print duplicate report"""
        duplicates = self.find_duplicates()
        
        if not duplicates:
            print("\n" + "="*60)
            print("✅ NO DUPLICATES FOUND ACROSS LOADED FILES")
            print("="*60)
            return
        
        print("\n" + "="*80)
        print(f"🔍 DUPLICATES FOUND: {len(duplicates)} code(s) appear in multiple files")
        print("="*80)
        
        for code, entries in duplicates.items():
            print(f"\n📌 CODE: {code}")
            print(f"   Appears in {len(entries)} file(s):")
            for i, entry in enumerate(entries, 1):
                print(f"\n   [{i}] Source: {entry['source_file']}")
                print(f"       Filename: {entry['filename']}")
                print(f"       Size: {entry['size_mb']} MB")
            print("\n" + "-"*80)
    
    def show_summary(self):
        """Show summary of loaded files"""
        print("\n" + "="*60)
        print("📊 CURRENT STATUS")
        print("="*60)
        print(f"Files loaded: {len(self.loaded_files)}")
        print(f"Total unique codes: {len(self.all_entries)}")
        
        duplicates = self.find_duplicates()
        print(f"Duplicate codes found: {len(duplicates)}")
        
        if self.loaded_files:
            print("\nLoaded files:")
            for i, f in enumerate(self.loaded_files, 1):
                print(f"  {i}. {os.path.basename(f)}")
    
    def export_duplicates(self, output_file):
        """Export duplicates to file"""
        duplicates = self.find_duplicates()
        
        if not duplicates:
            print("❌ No duplicates to export")
            return
        
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write("="*80 + "\n")
            f.write("DUPLICATE VIDEO CODES REPORT\n")
            f.write(f"Generated from {len(self.loaded_files)} JSON files\n")
            f.write("="*80 + "\n\n")
            
            for code, entries in duplicates.items():
                f.write(f"CODE: {code}\n")
                f.write(f"Found in {len(entries)} files:\n")
                for entry in entries:
                    f.write(f"  └─ File: {entry['source_file']}\n")
                    f.write(f"     Filename: {entry['filename']}\n")
                    f.write(f"     Size: {entry['size_mb']} MB\n")
                f.write("\n" + "-"*80 + "\n")
        
        print(f"✅ Report saved to: {output_file}")
    
    def reset(self):
        """Reset everything"""
        self.all_entries.clear()
        self.loaded_files.clear()
        print("\n✅ Reset complete. All loaded files cleared.\n")


def select_json_file():
    """Open file dialog to select ONE JSON file"""
    root = tk.Tk()
    root.withdraw()
    
    file_path = filedialog.askopenfilename(
        title="Select JSON file to load",
        filetypes=[("JSON files", "*.json"), ("All files", "*.*")]
    )
    
    root.destroy()
    return file_path if file_path else None


def main():
    """Main program - load files one by one manually"""
    finder = JSONDuplicateFinder()
    
    print("\n" + "="*80)
    print("🔍 JSON DUPLICATE FINDER - Load files one by one")
    print("="*80)
    print("\nThis tool lets you load JSON files ONE AT A TIME.")
    print("It will track duplicates ACROSS ALL files you load.")
    print("\nExample workflow:")
    print("  1. Load file 1")
    print("  2. Load file 2")
    print("  3. Load file 3")
    print("  4. Check for duplicates")
    print("  5. Load more files or reset")
    print("="*80)
    
    while True:
        finder.show_summary()
        
        print("\n" + "-"*40)
        print("OPTIONS:")
        print("  1. Load another JSON file")
        print("  2. Check for duplicates")
        print("  3. Show detailed duplicate report")
        print("  4. Export duplicates to file")
        print("  5. Reset (clear all loaded files)")
        print("  6. Exit")
        
        choice = input("\nEnter choice (1-6): ").strip()
        
        if choice == '1':
            print("\n📂 Select a JSON file to load...")
            file_path = select_json_file()
            
            if not file_path:
                print("❌ No file selected.")
                continue
            
            count = finder.add_json_file(file_path)
            
            if count > 0:
                print(f"\n✅ Loaded {count} video entries from {os.path.basename(file_path)}")
                # Immediately show if this file introduced any duplicates
                duplicates = finder.find_duplicates()
                if duplicates:
                    new_dupes = {code: entries for code, entries in duplicates.items() 
                                if any(entry['source_file'] == os.path.basename(file_path) for entry in entries)}
                    if new_dupes:
                        print(f"\n⚠️ This file introduced {len(new_dupes)} new duplicate(s)!")
            else:
                print(f"\n⚠️ No valid video entries found in {os.path.basename(file_path)}")
        
        elif choice == '2':
            duplicates = finder.find_duplicates()
            if duplicates:
                print(f"\n🔍 Found {len(duplicates)} duplicate codes across {len(finder.loaded_files)} files")
                for code, entries in duplicates.items():
                    files_list = ', '.join(set(e['source_file'] for e in entries))
                    print(f"   • {code} - appears in {len(entries)} files ({files_list})")
            else:
                print("\n✅ No duplicates found across all loaded files!")
        
        elif choice == '3':
            finder.print_duplicates()
        
        elif choice == '4':
            if finder.find_duplicates():
                root = tk.Tk()
                root.withdraw()
                output_file = filedialog.asksaveasfilename(
                    title="Save duplicate report",
                    defaultextension=".txt",
                    filetypes=[("Text files", "*.txt"), ("All files", "*.*")]
                )
                root.destroy()
                
                if output_file:
                    finder.export_duplicates(output_file)
            else:
                print("\n❌ No duplicates to export. Load more files first.")
        
        elif choice == '5':
            confirm = input("⚠️ Reset all loaded files? (y/n): ").strip().lower()
            if confirm == 'y':
                finder.reset()
        
        elif choice == '6':
            print("\n👋 Goodbye!")
            break
        
        else:
            print("\n❌ Invalid choice. Please enter 1-6.")


if __name__ == "__main__":
    main()